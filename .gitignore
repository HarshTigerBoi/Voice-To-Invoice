# Local Claude settings/permissions stay untracked, but the shared slash commands
# (/ship) are part of the repo. Must be `.claude/*` not `.claude/` -- git cannot
# re-include a child of an excluded directory.
.claude/*
!.claude/commands/
Web app/*/node_modules/
Web app/_extracted/

# JVM crash dumps from local Gradle/Kotlin daemon failures (OneDrive-sync file-lock
# issue documented in CLAUDE.md) -- these land in the repo root, not app/build/.
hs_err_pid*.log
replay_pid*.log

# Temporary scratch files and markers
scratch/
CLAUDE_FS_MARKER.txt



